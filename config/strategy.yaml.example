universe:
  ranking_type: MARKET_TRADING_AMOUNT
  ranking_types: [MARKET_TRADING_AMOUNT, MARKET_TRADING_VOLUME]
  ranking_durations: [1d, 1w, 1mo]
  ranking_count: 100
  watchlist_size: 180
  markets: [KOSPI, KOSDAQ]
  security_type: STOCK
  common_share_only: true
  exclude_investment_caution: true
  blocked_warning_types:
    - LIQUIDATION_TRADING
    - OVERHEATED
    - INVESTMENT_WARNING
    - INVESTMENT_RISK
    - STOCK_WARRANTS

signal:
  flow_lookback_sessions: 3
  ma_window: 20
  min_20d_return: 0.0
  max_3d_return: 0.13
  credit_lookback: 20
  max_credit_vs_avg: 1.5
  kospi_skip_1d_return: -0.02

entry:
  after_kst: "09:15"
  order_info_peak_start: "09:00"
  order_info_peak_end: "09:10"
  no_new_orders_until: "09:15"
  limit_offset_ticks: 0
  time_in_force: DAY

exit:
  take_profit: 0.06
  stop_loss: 0.04
  time_stop_sessions: 5
  oco_expire_days: 7
  flatten_near_limit_pct: 0.02
  overlay_vi_flatten: true

risk:
  max_positions: 8
  position_nav_pct: 0.10
  cash_buffer_pct: 0.20
  per_name_risk_pct: 0.02
  daily_loss_kill_pct: 0.02
  max_notional_per_name: 5000000000
  kospi_ownership_pct: 0.01
  kosdaq_ownership_pct: 0.02
  high_value_threshold: 100000000

cost:
  fallback_commission_rate: 0.00015
  stt:
    KOSPI: 0.0020
    KOSDAQ: 0.0020
    KONEX: 0.0010
    KR_ETC: 0.0020
  slippage_ticks: 1
