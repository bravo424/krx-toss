# Live config: creds, Telegram tokens, chat IDs, local YAML.
# Keep local copies; only *.example files are tracked.
config/*
!config/*.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/

# Data and logs
data/cache/
data/*.sqlite
data/*.db
data/kill_switch.json
logs/
*.parquet

# IDE
.idea/
.vscode/
.cursor/
*.code-workspace

# OS
Thumbs.db
.DS_Store
